# PARALLEL OK 8 #
dimension 2
bidim_axi
Probleme_Elasticite_Lineaire pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave Cavite
    {
        Origine 0. 0.
        Nombre_de_Noeuds 11 101
        Longueurs 0.25 1
    }
    {
        bord in   X = 0    0 <= Y <= 1
        bord haut Y = 1    0 <= X <= 0.25
        bord bas  Y = 0    0 <= X <= 0.25
        bord out  X = 0.25 0 <= Y <= 1
    }
}
# END MESH #

# BEGIN PARTITION
Decouper dom
{
    partitionneur metis { nb_parts 2 }
    nb_parts_tot 2
    Larg_joint 2
    Nom_Zones dom
}
Fin
END PARTITION #

# BEGIN SCATTER
Scatter dom.Zones dom
END SCATTER #

Scheme_euler_implicit sch
Read sch
{
    tinit 0
    facsec 1e30
    tmax 500
    dt_max 10
    seuil_statio -1
    solveur implicite
    {
        solveur petsc cholesky { }
        seuil_convergence_implicite 1e30
    }
}

EF dis

associate pb dom
Associate pb sch
Discretize pb dis

Read pb
{
    milieu_elasticite
    {
        rho champ_uniforme 1 1
        E champ_uniforme 1 $E
        nu champ_uniforme 1 $nu
    }

    Equation_Navier_Cauchy
    {
        diffusion { }
        initial_conditions { deplacement champ_uniforme 2 0 0 }
        boundary_conditions
        {

            haut paroi_pression_imposee champ_front_fonc_txyz 1   -(2*$lambda*$alpha+$beta*(2*$mu+$lambda))
            in   symetrie
            out  paroi_pression_imposee champ_front_fonc_txyz 1   -($lambda*$beta+$alpha*(2*$mu+2*$lambda))
            bas  symetrie # paroi_deplacement_impose champ_front_fonc_txyz 2 $alpha*x $beta*y #
        }
    }
    Post_processing
    {
        probes
        {
            dy  som deplacement            periode 1e8 segment 100 0.125 0.0  0.125 1
            dx  som deplacement            periode 1e8 segment 100 0.    0.5 0.25 0.5
            vm grav von_mises         periode 1e8 segment 100 0.    0.5 0.25 0.5
            sigma grav contraintes    periode 1e8 segment 100 0.125 0.0  0.125 1
            epsilon grav deformations periode 1e8 segment 100 0.125 0.0  0.125 1
        }
        format cgns
        fields dt_post 100
        {
            deplacement som
            von_mises elem
            contraintes elem
            lambda_lame elem
        }
    }
}

Solve pb
End

