# PARALLEL OK 8 #
dimension 2
Probleme_Elasticite_Lineaire pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave Cavite
    {
        Origine 0. 0.
        Nombre_de_Noeuds 10 10
        Longueurs 1 1
    }
    {
        bord bord X = 0  0 <= Y <= 1
        bord bord Y = 1  0 <= X <= 1
        bord bord Y = 0  0 <= X <= 1
        bord bord X = 1  0 <= Y <= 1
    }
}
# END MESH #

# BEGIN PARTITION
Decouper dom
{
    partitionneur metis { nb_parts 2 }
    nb_parts_tot 2
    Larg_joint 1
    Nom_Zones dom
}
Fin
END PARTITION #

# BEGIN SCATTER
Scatter dom.Zones dom
END SCATTER #

Scheme_euler_implicit sch
Read sch
{
    tinit 0
    facsec 1e10
    dt_max 0.1
    seuil_statio 1e-10
    solveur implicite
    {
        solveur petsc cholesky { }
        seuil_convergence_implicite 1e30
    }
}

EF dis

associate pb dom
Associate pb sch
Discretize pb dis

Read pb
{
    milieu_elasticite
    {
        rho champ_uniforme 1 1
        E champ_uniforme 1 20
        nu champ_uniforme 1 0
    }

    Equation_Navier_Cauchy
    {
        diffusion { }
        initial_conditions { deplacement champ_uniforme 2 0 0 }
        boundary_conditions
        {
            bord paroi_deplacement_impose champ_front_fonc_txyz 2 -sin(pi*x)*cos(pi*y) sin(pi*y)*cos(pi*x)
        }
        sources
        {
            source_qdm champ_fonc_xyz dom 2 -2*pi*pi*10*sin(pi*x)*cos(pi*y) 2*pi*pi*10*sin(pi*y)*cos(pi*x)
        }
    }
    Post_processing
    {
        probes
        {
            dx deplacement periode 1e8 segment 100 0 0.5 1 0.5
        }
        format cgns
        fields dt_post 100
        {
            deplacement som
        }
    }
}

Solve pb
End

