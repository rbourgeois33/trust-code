# PARALLEL OK 8 #
dimension 2
bidim_axi
Probleme_Elasticite_Lineaire pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave Cavite
    {
        Origine 0. 0.
        Nombre_de_Noeuds 101 101
        Longueurs 1 2
    }
    {
        bord in   X = 0    0 <= Y <= 2
        bord haut Y = 2    0 <= X <= 1
        bord bas  Y = 0    0 <= X <= 1
        bord out  X = 1    0 <= Y <= 2
    }
}
# END MESH #

# BEGIN PARTITION
Decouper dom
{
    partitionneur metis { nb_parts 2 }
    nb_parts_tot 2
    Larg_joint 1
    Nom_Zones dom
}
Fin
END PARTITION #

# BEGIN SCATTER
Scatter dom.Zones dom
END SCATTER #

Scheme_euler_implicit sch
Read sch
{
    tinit 0
	nb_pas_dt_max 3
    facsec 1e30
    tmax 500
    dt_max 1e-3
    seuil_statio 1e-12
    solveur implicite
    {
        solveur petsc cholesky { }
        seuil_convergence_implicite 1e30
    }
}

EF dis

associate pb dom
Associate pb sch
Discretize pb dis

Read pb
{
    milieu_elasticite
    {
        rho champ_uniforme 1 1
        E champ_uniforme 1 160000000000.0
        nu champ_uniforme 1 0.31
        alpha champ_uniforme 1 1.5e-05
    }

    Equation_Navier_Cauchy
    {
        diffusion { }
        initial_conditions { deplacement champ_uniforme 2 0 0 }
        boundary_conditions
        {

            haut paroi_pression_imposee champ_front_fonc_txyz 1 0
            in   symetrie
            out  paroi_pression_imposee champ_front_fonc_txyz 1 0
            bas  symetrie
        }
        sources
        {
            Source_Meca_Grad_Pression_Thermique { reference_temperature_field champ_uniforme 1 20 temperature_field champ_uniforme 1 500 }
        }
    }
    Post_processing
    {
        probes
        {
            dy  som deplacement       periode 1e8 segment 1000 0.5 0.0  0.5 2
            dx  som deplacement       periode 1e8 segment 1000 0.    1 1 1
        }
        format lml
        fields dt_post 100
        {
            deplacement som
            von_mises elem
            contraintes elem
            lambda_lame elem
        }
    }
}

Solve pb
End

